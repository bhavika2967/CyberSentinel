<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme using Material 3 Dark -->
    <style name="Theme.CyberSentinel" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/bg_midnight_indigo</item>
        <item name="android:navigationBarColor">@color/bg_midnight_indigo</item>
        <item name="android:windowBackground">@color/bg_midnight_indigo</item>
    </style>

    <!-- Translucent Overlay Theme for incoming call scam alert window -->
    <style name="Theme.CyberSentinel.TranslucentOverlay" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.85</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>

